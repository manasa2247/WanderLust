<% layout("/layouts/boilerplate") %>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h3>Create a new Listing</h3>
            <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3">
                    <lable for="title" class="form-label">Title : </lable>
                    <input 
                        name = "listing[title]" 
                        placeholder="enter title" 
                        type="text" 
                        class="form-control"
                        required
                    />
                    <div class="valid-feedback">Title looks good</div>
                </div>
                <div class="mb-3">
                    <lable for="description" class="form-label">Description : </lable>
                    <textarea 
                        name = "listing[description]" 
                        placeholder="enter description"
                        class="form-control"
                        required></textarea>
                        <div class="invalid-feedback">Please Enter a Short Description</div>
                </div>
                <div class="mb-3">
                    <lable for="image" class="form-label">Upload Listing Image </lable>
                    <input 
                        name = "listing[image]" 
                        type="file" 
                        class="form-control"
                        required
                    />
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4" >
                      <lable for="price" class="form-label">Price : </lable>
                        <input 
                            name = "listing[price]" 
                            placeholder="enter price" 
                            class="form-control"
                            required
                        />
                        <div class="invalid-feedback">Price must be valid</div>
                    </div>
                    <div class="mb-3">
                        <label for="category" class="form-label">Category :</label>

                        <select
                            name="listing[category]"
                            class="form-select"
                            required
                        >
                            <option value="">Select a category</option>
                            <option value="Trending">Trending</option>
                            <option value="Rooms">Rooms</option>
                            <option value="Iconic Cities">Iconic Cities</option>
                            <option value="Mountains">Mountains</option>
                            <option value="Castles">Castles</option>
                            <option value="Amazing Pools">Amazing Pools</option>
                            <option value="Camping">Camping</option>
                            <option value="Farms">Farms</option>
                            <option value="Arctic">Arctic</option>
                            <option value="Skiing">Skiing</option>
                            <option value="Cruise">Cruise</option>
                        </select>
                    </div>
                    <div class="mb-3 col-md-8">
                        <lable for="country" class="form-label">Country : </lable>
                        <input 
                            name = "listing[country]" 
                            placeholder="enter country" 
                            type="text" 
                            class="form-control"
                            required
                        />
                    </div>
                    <div class="invalid-feedback">Country must be valid</div>
                </div>
                
                <div class="mb-3">
                    <lable for="location" class="form-label">Location : </lable>
                    <input 
                        name = "listing[location]" 
                        placeholder="enter location" 
                        type="text" 
                        class="form-control"
                        required
                    />
                </div>
                <div class="invalid-feedback">Location must be valid</div>
                <button class="btn btn-dark add-btn mt-3">Add</button>
                <br/><br/><br/><br/><br/>
            </form>
       </div>
    </div>
